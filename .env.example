# ─────────────────────────────────────────────────────────────
# FSP WhatsApp Bot — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# --- Evolution GO (you provide these) ------------------------
# Origin of your Evolution GO server. The manager URL also works —
# only the origin is used.
EVOLUTION_API_URL=https://your-evolution.up.railway.app
# The GLOBAL api key of that server (authorises /instance/all).
EVOLUTION_API_KEY=
# The instance name holding the FSP WhatsApp number.
EVOLUTION_INSTANCE=fsp
# Optional: that instance's own token. Left blank, it is resolved from
# /instance/all by name using the global key above.
EVOLUTION_INSTANCE_TOKEN=

# --- Webhook security ----------------------------------------
# Shared secret. Evolution must call /api/webhook/evolution?token=THIS
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_TOKEN=

# --- Dashboard sessions ---------------------------------------
# Signs the login cookie. Generate the same way as WEBHOOK_TOKEN.
SESSION_SECRET=

# --- Bot behaviour --------------------------------------------
# Master switch. false = log and store everything, send nothing.
BOT_ENABLED=true
# Public site the bot may link to.
FSP_WEBSITE_URL=https://fsp-beta.vercel.app/
# Human-readable working hours, used by the out-of-hours template.
BOT_WORKING_HOURS=Mon-Sat, 10am - 7pm IST
BOT_TZ_OFFSET_MINUTES=330
BOT_HOURS_START=10
BOT_HOURS_END=19
# Seconds to wait before replying, so it does not feel robotic.
BOT_REPLY_DELAY_MS=1200
# Mark the chat read / show "typing" before replying.
BOT_SEND_PRESENCE=true

# --- Where the SQLite file lives ------------------------------
DB_PATH=./data/fsp.db
